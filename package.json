{
  "name": "heddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "heddle": "src/main.tsx"
  },
  "scripts": {
    "test": "bun test",
    "test:store": "bun --bun vitest run --maxWorkers=2",
