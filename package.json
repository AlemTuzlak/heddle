    "build": "bun build --compile src/main.tsx --outfile dist/heddle"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-anthropic": "^1.0.0",
    "@tanstack/ai-code-mode": "^1.0.0",
    "@tanstack/ai-grok": "^1.0.0",
    "@tanstack/ai-harness": "^0.1.0",
    "@tanstack/ai-isolate-quickjs": "^1.0.0",
    "@tanstack/ai-mcp": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/ai-persistence": "^1.0.0",
    "@tanstack/ai-sandbox": "^1.0.0",
    "@tanstack/ai-sandbox-docker": "^1.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
